{
  "name": "toolshed",
  "version": "1.0.0",
  "description": "Online EXE runner and file converter",
  "main": "index.js",
  "scripts": {
    "prestart": "node scripts/setup-boxedwine.js",
    "start": "node index.js",
    "dev": "nodemon index.js"
  },
  "bin": "index.js",
  "pkg": {
    "assets": [
      "views/**/*.ejs",
      "public/**/*"
    ],
    "targets": [
      "node18-win-x64",
      "node18-macos-x64",
      "node18-linux-x64"
    ],
    "outputPath": "dist"
  },
  "dependencies": {
    "bcrypt": "^5.1.0",
    "connect-mongo": "^6.0.0",
    "dotenv": "^16.0.0",
    "ejs": "^3.1.9",
    "extract-zip": "^2.0.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.17.3",
    "mongoose": "^7.6.0"
  }
}
