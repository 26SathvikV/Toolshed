        var i=Math.floor(h/60)%6,f=h/60-Math.floor(h/60),p=v*(1-s),q=v*(1-f*s),t=v*(1-(1-f)*s),r,g,b;
        switch(i){case 0:r=v;g=t;b=p;break;case 1:r=q;g=v;b=p;break;case 2:r=p;g=v;b=t;break;case 3:r=p;g=q;b=v;break;case 4:r=t;g=p;b=v;break;default:r=v;g=p;b=q;}
        return {r:Math.round(r*255),g:Math.round(g*255),b:Math.round(b*255)};
    }
    function rgbToCmyk(r,g,b) {
        r/=255;g/=255;b/=255;
        var k=1-Math.max(r,g,b);
        if(k===1) return {c:0,m:0,y:0,k:100};
        return {c:Math.round((1-r-k)/(1-k)*100),m:Math.round((1-g-k)/(1-k)*100),y:Math.round((1-b-k)/(1-k)*100),k:Math.round(k*100)};
    }
    function cmykToRgb(c,m,y,k) {
        c/=100;m/=100;y/=100;k/=100;
        return {r:Math.round(255*(1-c)*(1-k)),g:Math.round(255*(1-m)*(1-k)),b:Math.round(255*(1-y)*(1-k))};
    }
    function luminance(r,g,b) {
        var a=[r,g,b].map(function(v){ v/=255; return v<=0.03928?v/12.92:Math.pow((v+0.055)/1.055,2.4); });
        return 0.2126*a[0]+0.7152*a[1]+0.0722*a[2];
    }
    function setAllColorFields(r,g,b) {
        var hex=rgbToHex(r,g,b),hsl=rgbToHsl(r,g,b),hsv=rgbToHsv(r,g,b),cmyk=rgbToCmyk(r,g,b);
        document.getElementById('colorHex').value=hex;
        document.getElementById('colorRgb').value='rgb('+r+', '+g+', '+b+')';
        document.getElementById('colorHsl').value='hsl('+hsl.h+', '+hsl.s+'%, '+hsl.l+'%)';
        document.getElementById('colorHsv').value='hsv('+hsv.h+', '+hsv.s+'%, '+hsv.v+'%)';
        document.getElementById('colorCmyk').value='cmyk('+cmyk.c+'%, '+cmyk.m+'%, '+cmyk.y+'%, '+cmyk.k+'%)';
        document.getElementById('colorPicker').value=hex.length===7?hex:'#000000';
        document.getElementById('colorSwatch').style.background=hex;
        var name='';
        Object.keys(CSS_NAMES).forEach(function(n){ if(CSS_NAMES[n].toUpperCase()===hex.toUpperCase()) name=n; });
        document.getElementById('colorName').value=name||'-';
        var L=luminance(r,g,b),Lw=luminance(255,255,255),Lb=luminance(0,0,0);
        var contrastW=(Lw+0.05)/(L+0.05),contrastB=(L+0.05)/(Lb+0.05);
        document.getElementById('colorContrast').innerHTML=
            'Contrast vs white: <strong>'+contrastW.toFixed(2)+':1</strong> · vs black: <strong>'+contrastB.toFixed(2)+':1</strong>';
    }
    function colorFromPicker() {
        var rgb=hexToRgb(document.getElementById('colorPicker').value);
        setAllColorFields(rgb.r,rgb.g,rgb.b);
    }
    function colorFromField(type) {
        try {
            var rgb;
            if(type==='hex'){rgb=hexToRgb(document.getElementById('colorHex').value.trim());}
            else if(type==='rgb'){var m=document.getElementById('colorRgb').value.match(/(\d+)/g);rgb={r:+m[0],g:+m[1],b:+m[2]};}
            else if(type==='hsl'){var m=document.getElementById('colorHsl').value.match(/[\d.]+/g);rgb=hslToRgb(+m[0],+m[1],+m[2]);}
            else if(type==='hsv'){var m=document.getElementById('colorHsv').value.match(/[\d.]+/g);rgb=hsvToRgb(+m[0],+m[1],+m[2]);}
            else if(type==='cmyk'){var m=document.getElementById('colorCmyk').value.match(/[\d.]+/g);rgb=cmykToRgb(+m[0],+m[1],+m[2],+m[3]);}
            if(rgb&&!isNaN(rgb.r)) setAllColorFields(rgb.r,rgb.g,rgb.b);
        } catch(e){}
    }

    // ── Shared helpers ────────────────────────────────────────────────────────────
    function copyText(id) {
        var el = document.getElementById(id);
        if (el.select) { el.select(); document.execCommand('copy'); }
    }
    function downloadText(id, name, type) {
        var text = document.getElementById(id).value;
        var a = document.createElement('a');
        a.href = URL.createObjectURL(new Blob([text], {type:type}));
        a.download = name; a.click();
    }
</script>
