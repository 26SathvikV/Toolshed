<!--
    Tools Page
    This page provides various encoding, text, and number utilities that run entirely in the user's browser. It includes tools for Base64 encoding/decoding, URL encoding, text transformations, number base conversions, hash generation, timestamp conversions, Markdown editing, and color format conversions.
-->

<!-- Tools Page Styles -->
<style>
    .tab-content { display: none; }
    .tab-content.active { display: block; }

    .tool-card {
        background: var(--form-bg-color);
        border: 1px solid var(--form-border-color);
        border-radius: 10px;
        padding: 24px;
        margin-bottom: 20px;
    }

    .tool-row {
        display: flex;
        gap: 16px;
        align-items: flex-start;
        flex-wrap: wrap;
    }

    .tool-col { flex: 1; min-width: 200px; }

    .tool-arrow {
        display: flex;
        align-items: center;
        padding-top: 32px;
        font-size: 1.4rem;
        color: var(--link-color);
        flex-shrink: 0;
    }

    textarea.mono {
        font-family: 'Courier New', monospace;
        font-size: 13px;
        width: 100%;
        min-height: 160px;
        resize: vertical;
        box-sizing: border-box;
    }

    .tool-actions { display: flex; gap: 10px; margin-top: 12px; flex-wrap: wrap; }

    .result-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--link-color);
        margin-bottom: 6px;
    }

    .stat-box {
        display: flex;
        gap: 24px;
        margin-top: 12px;
        flex-wrap: wrap;
    }
    .stat-item .result-label { margin-bottom: 2px; }
    .stat-value { font-size: 1.4rem; color: var(--heading-color); }

    .base-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }
    @media (max-width: 600px) { .base-grid { grid-template-columns: 1fr; } }

    .md-split {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }
    @media (max-width: 700px) { .md-split { grid-template-columns: 1fr; } }

    #mdPreview {
        line-height: 1.65;
        color: var(--text-color);
        min-height: 80px;
    }
    #mdPreview h1,#mdPreview h2,#mdPreview h3,#mdPreview h4 { color: var(--heading-color); margin-top: 0.8em; }
    #mdPreview pre { background: var(--code-bg-color); border-radius: 5px; padding: 10px; overflow-x: auto; }
    #mdPreview code { font-family: 'Courier New', monospace; font-size: 13px; background: var(--code-bg-color); padding: 1px 4px; border-radius: 3px; }
    #mdPreview pre code { background: none; padding: 0; }
    #mdPreview blockquote { border-left: 3px solid var(--link-color); margin: 0; padding-left: 14px; color: var(--link-color); }
    #mdPreview table { border-collapse: collapse; width: 100%; }
    #mdPreview th,#mdPreview td { border: 1px solid var(--form-border-color); padding: 6px 10px; }
    #mdPreview th { background: var(--table-header-bg-color); }
</style>

<!-- Tools Page Content -->
<h2>Tools</h2>
<p style="text-align:center;color:var(--link-color);margin-bottom:24px;">
    Encoding, text, and number utilities
</p>

<div class="tab-bar">
    <button class="tab-btn active" onclick="switchTab('base64',this)">Base64</button>
    <button class="tab-btn" onclick="switchTab('url',this)">URL Encoding</button>
    <button class="tab-btn" onclick="switchTab('text',this)">Text</button>
    <button class="tab-btn" onclick="switchTab('numbers',this)">Numbers</button>
    <button class="tab-btn" onclick="switchTab('hash',this)">Hash</button>
    <button class="tab-btn" onclick="switchTab('timestamp',this)">Timestamp</button>
    <button class="tab-btn" onclick="switchTab('markdown',this)">Markdown</button>
    <button class="tab-btn" onclick="switchTab('color',this)">Color</button>
</div>

<!-- BASE64 -->
<div id="tab-base64" class="tab-content active">
    <div class="tool-card">
        <h3 style="text-align:left;margin-top:0">Base64 Encode / Decode</h3>
        <div class="tool-row">
            <div class="tool-col">
                <div class="result-label">Plain Text</div>
                <textarea class="mono" id="b64In" placeholder="Enter text to encode…"></textarea>
                <div class="tool-actions">
                    <button onclick="b64Encode()">Encode →</button>
                    <button onclick="b64Decode()" style="background:transparent;border:1px solid var(--form-border-color);color:var(--text-color)">← Decode</button>
                </div>
            </div>
            <div class="tool-col">
                <div class="result-label">Base64</div>
                <textarea class="mono" id="b64Out" placeholder="Base64 output…"></textarea>
                <div class="tool-actions">
                    <button onclick="copyText('b64Out')" style="background:transparent;border:1px solid var(--form-border-color);color:var(--text-color)">Copy</button>
                </div>
            </div>
        </div>
        <div style="margin-top:12px">
            <label style="font-size:0.85rem;color:var(--link-color)">
                <input type="checkbox" id="b64FileMode" style="width:auto;padding:0;border:none"> Encode a file to Base64
            </label>
            <input type="file" id="b64File" style="display:none;margin-top:8px;width:100%;box-sizing:border-box" onchange="b64EncodeFile()">
        </div>
    </div>
</div>

<!-- URL ENCODING -->
<div id="tab-url" class="tab-content">
    <div class="tool-card">
        <h3 style="text-align:left;margin-top:0">URL Encoding</h3>
        <div class="tool-row">
            <div class="tool-col">
                <div class="result-label">Decoded</div>
                <textarea class="mono" id="urlIn" placeholder="hello world / path?q=1&r=2"></textarea>
            </div>
            <div class="tool-arrow">&#8644;</div>
            <div class="tool-col">
                <div class="result-label">URL Encoded</div>
                <textarea class="mono" id="urlOut" placeholder="Output…"></textarea>
            </div>
        </div>
        <div class="tool-actions">
            <button onclick="urlEncode()">Encode →</button>
            <button onclick="urlDecode()" style="background:transparent;border:1px solid var(--form-border-color);color:var(--text-color)">← Decode</button>
            <button onclick="copyText('urlOut')" style="background:transparent;border:1px solid var(--form-border-color);color:var(--text-color)">Copy</button>
        </div>
    </div>

    <div class="tool-card">
        <h3 style="text-align:left;margin-top:0">HTML Entity Encoding</h3>
        <div class="tool-row">
            <div class="tool-col">
                <div class="result-label">Plain Text</div>
                <textarea class="mono" id="htmlIn" placeholder='<div class="hello">World & friends</div>'></textarea>
            </div>
            <div class="tool-arrow">&#8644;</div>
            <div class="tool-col">
                <div class="result-label">HTML Entities</div>
                <textarea class="mono" id="htmlOut" placeholder="Output…"></textarea>
            </div>
        </div>
        <div class="tool-actions">
            <button onclick="htmlEncode()">Encode →</button>
            <button onclick="htmlDecode()" style="background:transparent;border:1px solid var(--form-border-color);color:var(--text-color)">← Decode</button>
            <button onclick="copyText('htmlOut')" style="background:transparent;border:1px solid var(--form-border-color);color:var(--text-color)">Copy</button>
        </div>
    </div>
</div>

<!-- TEXT -->
<div id="tab-text" class="tab-content">
    <div class="tool-card">
        <h3 style="text-align:left;margin-top:0">Text Transformer</h3>
        <div class="form-group">
            <label>Input text</label>
            <textarea class="mono" id="textIn" placeholder="Enter text…" style="min-height:120px"></textarea>
        </div>
        <div class="tool-actions" style="flex-wrap:wrap">
            <button onclick="textTransform('upper')">UPPERCASE</button>
            <button onclick="textTransform('lower')" style="background:var(--table-header-bg-color);color:var(--text-color);border:1px solid var(--form-border-color)">lowercase</button>
            <button onclick="textTransform('title')" style="background:var(--table-header-bg-color);color:var(--text-color);border:1px solid var(--form-border-color)">Title Case</button>
            <button onclick="textTransform('sentence')" style="background:var(--table-header-bg-color);color:var(--text-color);border:1px solid var(--form-border-color)">Sentence case</button>
            <button onclick="textTransform('camel')" style="background:var(--table-header-bg-color);color:var(--text-color);border:1px solid var(--form-border-color)">camelCase</button>
            <button onclick="textTransform('snake')" style="background:var(--table-header-bg-color);color:var(--text-color);border:1px solid var(--form-border-color)">snake_case</button>
            <button onclick="textTransform('kebab')" style="background:var(--table-header-bg-color);color:var(--text-color);border:1px solid var(--form-border-color)">kebab-case</button>
            <button onclick="textTransform('reverse')" style="background:var(--table-header-bg-color);color:var(--text-color);border:1px solid var(--form-border-color)">Reverse</button>
            <button onclick="textTransform('lines')" style="background:var(--table-header-bg-color);color:var(--text-color);border:1px solid var(--form-border-color)">Sort Lines</button>
            <button onclick="textTransform('dedup')" style="background:var(--table-header-bg-color);color:var(--text-color);border:1px solid var(--form-border-color)">Remove Duplicates</button>
            <button onclick="textTransform('trim')" style="background:var(--table-header-bg-color);color:var(--text-color);border:1px solid var(--form-border-color)">Trim Lines</button>
            <button onclick="textTransform('removeEmpty')" style="background:var(--table-header-bg-color);color:var(--text-color);border:1px solid var(--form-border-color)">Remove Empty Lines</button>
        </div>
        <div style="margin-top:16px">
            <div class="result-label">Output</div>
            <textarea class="mono" id="textOut" readonly style="min-height:120px" placeholder="Result…"></textarea>
        </div>
        <div class="tool-actions">
            <button onclick="copyText('textOut')" style="background:transparent;border:1px solid var(--form-border-color);color:var(--text-color)">Copy</button>
            <button onclick="downloadText('textOut','output.txt','text/plain')" style="background:transparent;border:1px solid var(--form-border-color);color:var(--text-color)">Download .txt</button>
            <span id="textStats" style="font-size:0.8rem;color:var(--link-color);align-self:center"></span>
        </div>
    </div>

    <div class="tool-card">
        <h3 style="text-align:left;margin-top:0">Word / Character Counter</h3>
        <textarea class="mono" id="counterIn" placeholder="Paste text here…" style="min-height:100px" oninput="updateCounter()"></textarea>
        <div class="stat-box">
            <div class="stat-item"><div class="result-label">Characters</div><div class="stat-value" id="cntChars">0</div></div>
            <div class="stat-item"><div class="result-label">No spaces</div><div class="stat-value" id="cntCharsNoSp">0</div></div>
            <div class="stat-item"><div class="result-label">Words</div><div class="stat-value" id="cntWords">0</div></div>
            <div class="stat-item"><div class="result-label">Lines</div><div class="stat-value" id="cntLines">0</div></div>
            <div class="stat-item"><div class="result-label">Sentences</div><div class="stat-value" id="cntSent">0</div></div>
            <div class="stat-item"><div class="result-label">Paragraphs</div><div class="stat-value" id="cntPara">0</div></div>
        </div>
    </div>
</div>

<!-- NUMBERS -->
<div id="tab-numbers" class="tab-content">
    <div class="tool-card">
        <h3 style="text-align:left;margin-top:0">Number Base Converter</h3>
        <p style="font-size:0.85rem;color:var(--link-color);margin:0 0 16px">Type in any field to convert to all others.</p>
        <div class="base-grid">
            <div class="form-group">
                <label>Decimal (base 10)</label>
                <input type="text" id="baseDec" placeholder="255" oninput="convertBase(this,'dec')">
            </div>
            <div class="form-group">
                <label>Hexadecimal (base 16)</label>
                <input type="text" id="baseHex" placeholder="FF" oninput="convertBase(this,'hex')">
            </div>
            <div class="form-group">
                <label>Binary (base 2)</label>
                <input type="text" id="baseBin" placeholder="11111111" oninput="convertBase(this,'bin')">
            </div>
            <div class="form-group">
                <label>Octal (base 8)</label>
                <input type="text" id="baseOct" placeholder="377" oninput="convertBase(this,'oct')">
            </div>
        </div>
        <div id="baseError" style="color:#ff6b6b;font-size:0.85rem;margin-top:8px;display:none"></div>
    </div>
</div>

<!-- HASH -->
<div id="tab-hash" class="tab-content">
    <div class="tool-card">
        <h3 style="text-align:left;margin-top:0">Hash Generator</h3>
        <p style="font-size:0.85rem;color:var(--link-color);margin:0 0 16px">Computed locally in your browser using the Web Crypto API.</p>
        <div class="form-group">
            <label>Input text</label>
            <textarea class="mono" id="hashIn" placeholder="Enter text to hash…" style="min-height:80px" oninput="autoHash()"></textarea>
        </div>
        <div class="form-group" style="margin-top:8px">
            <label>Or hash a file</label>
            <input type="file" id="hashFile" style="display:block;width:100%;box-sizing:border-box" onchange="hashFileInput()">
        </div>
        <div style="margin-top:16px">
            <div class="result-label">MD5 <span style="font-size:0.7rem;opacity:0.6">(not cryptographically secure)</span></div>
            <input type="text" id="hashMd5" readonly style="font-family:monospace;font-size:12px;width:100%;box-sizing:border-box" placeholder="-">
            <div class="result-label" style="margin-top:12px">SHA-1 <span style="font-size:0.7rem;opacity:0.6">(not cryptographically secure)</span></div>
            <input type="text" id="hashSha1" readonly style="font-family:monospace;font-size:12px;width:100%;box-sizing:border-box" placeholder="-">
            <div class="result-label" style="margin-top:12px">SHA-256</div>
            <input type="text" id="hashSha256" readonly style="font-family:monospace;font-size:12px;width:100%;box-sizing:border-box" placeholder="-">
            <div class="result-label" style="margin-top:12px">SHA-512</div>
            <input type="text" id="hashSha512" readonly style="font-family:monospace;font-size:12px;width:100%;box-sizing:border-box" placeholder="-">
        </div>
    </div>
</div>

<!-- TIMESTAMP -->
<div id="tab-timestamp" class="tab-content">
    <div class="tool-card">
        <h3 style="text-align:left;margin-top:0">Unix Timestamp Converter</h3>
        <div class="tool-row">
            <div class="tool-col">
                <div class="form-group">
                    <label>Unix timestamp (seconds)</label>
                    <div style="display:flex;gap:8px">
                        <input type="number" id="tsUnix" placeholder="e.g. 1700000000" style="flex:1">
                        <button onclick="tsFromUnix()">Convert</button>
                    </div>
                </div>
                <div style="margin-top:8px">
                    <button onclick="tsNow()" style="background:transparent;border:1px solid var(--form-border-color);color:var(--text-color);font-size:0.85rem">Use current time</button>
                </div>
            </div>
            <div class="tool-arrow" style="padding-top:28px">&#8644;</div>
            <div class="tool-col">
                <div class="form-group">
                    <label>Human-readable (local)</label>
                    <input type="datetime-local" id="tsHuman" style="width:100%;box-sizing:border-box">
                </div>
                <div style="margin-top:8px">
                    <button onclick="tsFromHuman()">Convert</button>
                </div>
            </div>
        </div>
        <div id="tsResult" style="margin-top:20px;display:none">
            <div class="base-grid" style="gap:12px">
                <div><div class="result-label">Unix (s)</div><input type="text" id="tsOutSec" readonly style="font-family:monospace;font-size:13px;width:100%;box-sizing:border-box"></div>
                <div><div class="result-label">Unix (ms)</div><input type="text" id="tsOutMs" readonly style="font-family:monospace;font-size:13px;width:100%;box-sizing:border-box"></div>
                <div><div class="result-label">UTC</div><input type="text" id="tsOutUtc" readonly style="font-family:monospace;font-size:13px;width:100%;box-sizing:border-box"></div>
                <div><div class="result-label">ISO 8601</div><input type="text" id="tsOutIso" readonly style="font-family:monospace;font-size:13px;width:100%;box-sizing:border-box"></div>
                <div><div class="result-label">Relative</div><input type="text" id="tsOutRel" readonly style="font-family:monospace;font-size:13px;width:100%;box-sizing:border-box"></div>
                <div><div class="result-label">Day of week</div><input type="text" id="tsOutDay" readonly style="font-family:monospace;font-size:13px;width:100%;box-sizing:border-box"></div>
            </div>
        </div>
    </div>
</div>

<!-- MARKDOWN -->
