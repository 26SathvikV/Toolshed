        <div class="tool-actions" style="margin-top:12px">
            <button onclick="copyText('mdOut')">Copy HTML</button>
            <button onclick="downloadText('mdOut','output.html','text/html')" style="background:transparent;border:1px solid var(--form-border-color);color:var(--text-color)">Download .html</button>
            <span id="mdStatus" style="font-size:0.8rem;color:var(--link-color);align-self:center"></span>
