    // ── Timestamp ────────────────────────────────────────────────────────────────
    // Converts current time to Unix timestamp and updates the fields
    function tsNow() { if (!toolOp()) return; document.getElementById('tsUnix').value = Math.floor(Date.now() / 1000); tsFromUnix(); }

    // Converts Unix timestamp to human-readable format and updates the fields
    function tsFromUnix() {
        var secs = parseInt(document.getElementById('tsUnix').value); if (isNaN(secs)) return;
        var d = new Date(secs * 1000);
        var pad = function(n){ return String(n).padStart(2,'0'); };
        document.getElementById('tsHuman').value = d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate())+'T'+pad(d.getHours())+':'+pad(d.getMinutes());
        showTsResult(d, secs);
    }

    // Converts human-readable date/time to Unix timestamp and updates the fields
    function tsFromHuman() {
        var val = document.getElementById('tsHuman').value; if (!val) return;
        var d = new Date(val), secs = Math.floor(d.getTime() / 1000);
        document.getElementById('tsUnix').value = secs; showTsResult(d, secs);
    }

    // Updates the result fields with various formats based on the given date and Unix timestamp
    function showTsResult(d, secs) {
        document.getElementById('tsResult').style.display = 'block';
        document.getElementById('tsOutSec').value = secs;
        document.getElementById('tsOutMs').value = secs * 1000;
        document.getElementById('tsOutUtc').value = d.toUTCString();
        document.getElementById('tsOutIso').value = d.toISOString();
        document.getElementById('tsOutDay').value = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'][d.getDay()];
        var now = Date.now() / 1000, diff = Math.abs(now - secs), dir = secs > now ? 'from now' : 'ago', rel;
        if (diff < 60) rel = Math.round(diff) + ' seconds ' + dir;
        else if (diff < 3600) rel = Math.round(diff/60) + ' minutes ' + dir;
        else if (diff < 86400) rel = Math.round(diff/3600) + ' hours ' + dir;
        else rel = Math.round(diff/86400) + ' days ' + dir;
        document.getElementById('tsOutRel').value = rel;
    }

