        <div class="md-split">
            <div>
                <div class="result-label">Markdown source</div>
                <textarea class="mono" id="mdIn" placeholder="# Hello World&#10;&#10;**Bold**, *italic*, and `code`.&#10;&#10;- Item one&#10;- Item two&#10;&#10;> A blockquote" style="min-height:320px" oninput="mdLive()"></textarea>
