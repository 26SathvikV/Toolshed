</div>

<!-- Tools Page Scripts -->
<script>
    // ── Daily tool-operation limit ────────────────────────────────────────────────
    const _TL_PLAN    = '<%= (locals.user && user.plan) ? user.plan : "guest" %>';
    const _TL_BILLING = '<%- (!locals.monetizationHidden && locals.billingUrl && billingUrl) ? billingUrl : "" %>';
    const _TL_LIMITS  = { guest: 50, free: 50, pro: null, studio: null };
    const _TL_KEY     = 'ts_tools';
    const _TL_TODAY   = new Date().toISOString().slice(0, 10);

    // Returns the number of tool operations used today
    function _tlUsed() {
        try {
            var d = JSON.parse(localStorage.getItem(_TL_KEY) || '{}');
            return (d.date === _TL_TODAY) ? (d.count || 0) : 0;
        } catch(e) { return 0; }
    }

    // Increments the tool operation count for today
    function _tlIncrement() {
        try {
            var d = JSON.parse(localStorage.getItem(_TL_KEY) || '{}');
            var count = (d.date === _TL_TODAY ? (d.count || 0) : 0) + 1;
            localStorage.setItem(_TL_KEY, JSON.stringify({ date: _TL_TODAY, count: count }));
        } catch(e) {}
    }

    // Checks if the user has reached their daily tool-operation limit
    function toolOp() {
        var limit = (_TL_LIMITS[_TL_PLAN] !== undefined) ? _TL_LIMITS[_TL_PLAN] : _TL_LIMITS.free;
        if (limit === null) return true;
        var used = _tlUsed();
        if (used >= limit) {
            var upgradeHtml = _TL_BILLING
                ? ' <a href="' + _TL_BILLING + '" target="_blank" rel="noopener" style="color:var(--link-color)">Upgrade ↗</a>'
                : '';
            var el = document.getElementById('_tlLimitMsg');
            if (!el) {
                el = document.createElement('div');
                el.id = '_tlLimitMsg';
                el.style.cssText = 'position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:var(--form-bg-color);border:1px solid var(--form-border-color);border-radius:8px;padding:10px 18px;font-size:0.82rem;z-index:9999;box-shadow:0 2px 14px rgba(0,0,0,0.18);white-space:nowrap';
                document.body.appendChild(el);
            }
            el.innerHTML = 'Daily limit reached (' + used + '/' + limit + ' tool operations).' + upgradeHtml +
                ' <button onclick="document.getElementById(\'_tlLimitMsg\').remove()" style="background:transparent;border:none;cursor:pointer;font-size:1rem;margin-left:8px;opacity:0.5;vertical-align:middle">×</button>';
            return false;
        }
        _tlIncrement();
        return true;
    }

    // ── Tab Switching ─────────────────────────────────────────────────────────────
    function switchTab(id, btn) {
        document.querySelectorAll('.tab-content').forEach(function(t){ t.classList.remove('active'); });
        document.querySelectorAll('.tab-btn').forEach(function(b){ b.classList.remove('active'); });
        document.getElementById('tab-' + id).classList.add('active');
        btn.classList.add('active');
    }

    // ── Base64 ───────────────────────────────────────────────────────────────────
    document.getElementById('b64FileMode').addEventListener('change', function() {
        document.getElementById('b64File').style.display = this.checked ? 'block' : 'none';
    });
    function b64Encode() {
        if (!toolOp()) return;
        try { document.getElementById('b64Out').value = btoa(document.getElementById('b64In').value); }
        catch(e) { document.getElementById('b64Out').value = btoa(unescape(encodeURIComponent(document.getElementById('b64In').value))); }
    }
    function b64Decode() {
        if (!toolOp()) return;
        try { document.getElementById('b64In').value = atob(document.getElementById('b64Out').value.trim()); }
        catch(e) { document.getElementById('b64In').value = 'Error decoding: ' + e.message; }
    }
    function b64EncodeFile() {
        if (!toolOp()) return;
        var file = document.getElementById('b64File').files[0]; if (!file) return;
        var reader = new FileReader();
        reader.onload = function(e) { document.getElementById('b64Out').value = e.target.result.split(',')[1]; };
        reader.readAsDataURL(file);
    }

    // ── URL Encoding ──────────────────────────────────────────────────────────────
    function urlEncode() { if (!toolOp()) return; document.getElementById('urlOut').value = encodeURIComponent(document.getElementById('urlIn').value); }
    function urlDecode() {
        if (!toolOp()) return;
        try { document.getElementById('urlIn').value = decodeURIComponent(document.getElementById('urlOut').value); }
        catch(e) { document.getElementById('urlIn').value = 'Decode error: ' + e.message; }
    }

    // ── HTML Entity Encoding ──────────────────────────────────────────────────────
    function htmlEncode() {
        if (!toolOp()) return;
        var t = document.getElementById('htmlIn').value;
        document.getElementById('htmlOut').value = t
            .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
            .replace(/"/g,'&quot;').replace(/'/g,'&#39;');
    }
    function htmlDecode() {
        if (!toolOp()) return;
        var d = document.createElement('div');
        d.innerHTML = document.getElementById('htmlOut').value;
        document.getElementById('htmlIn').value = d.textContent;
    }

    // ── Text Transformer ──────────────────────────────────────────────────────────
    function textTransform(op) {
        if (!toolOp()) return;
        var inp = document.getElementById('textIn').value;
        var out;
        switch(op) {
            case 'upper':       out = inp.toUpperCase(); break;
            case 'lower':       out = inp.toLowerCase(); break;
            case 'title':       out = inp.replace(/\b\w/g, function(c){ return c.toUpperCase(); }); break;
            case 'sentence':    out = inp.replace(/(^\s*\w|[.!?]\s+\w)/g, function(c){ return c.toUpperCase(); }); break;
            case 'camel':       out = inp.trim().replace(/[\s_-]+(\w)/g, function(_,c){ return c.toUpperCase(); }).replace(/^\w/, function(c){ return c.toLowerCase(); }); break;
            case 'snake':       out = inp.trim().toLowerCase().replace(/[\s-]+/g,'_').replace(/[^\w_]/g,''); break;
            case 'kebab':       out = inp.trim().toLowerCase().replace(/[\s_]+/g,'-').replace(/[^\w-]/g,''); break;
            case 'reverse':     out = inp.split('').reverse().join(''); break;
            case 'lines':       out = inp.split('\n').sort().join('\n'); break;
            case 'dedup':       out = inp.split('\n').filter(function(v,i,a){ return a.indexOf(v)===i; }).join('\n'); break;
            case 'trim':        out = inp.split('\n').map(function(l){ return l.trim(); }).join('\n'); break;
            case 'removeEmpty': out = inp.split('\n').filter(function(l){ return l.trim().length > 0; }).join('\n'); break;
            default:            out = inp;
        }
        document.getElementById('textOut').value = out;
        var wc = out.trim().split(/\s+/).filter(Boolean).length;
        document.getElementById('textStats').textContent = out.length + ' chars · ' + wc + ' words';
    }

    // ── Word Counter ──────────────────────────────────────────────────────────────
    function updateCounter() {
        var t = document.getElementById('counterIn').value;
        document.getElementById('cntChars').textContent = t.length;
        document.getElementById('cntCharsNoSp').textContent = t.replace(/\s/g,'').length;
        document.getElementById('cntWords').textContent = t.trim() ? t.trim().split(/\s+/).length : 0;
        document.getElementById('cntLines').textContent = t ? t.split('\n').length : 0;
        document.getElementById('cntSent').textContent = (t.match(/[.!?]+/g) || []).length;
        document.getElementById('cntPara').textContent = t.trim() ? t.trim().split(/\n\s*\n/).length : 0;
    }

    // ── Number Base Converter ────────────────────────────────────────────────────
    function convertBase(src, from) {
        var errEl = document.getElementById('baseError');
        errEl.style.display = 'none';
        var raw = src.value.trim().toUpperCase();
        if (!raw) {
            ['baseDec','baseHex','baseBin','baseOct'].forEach(function(id){ if(document.getElementById(id) !== src) document.getElementById(id).value = ''; });
            return;
        }
        var dec;
        try {
            switch(from) {
                case 'dec': dec = parseInt(raw, 10); break;
                case 'hex': dec = parseInt(raw, 16); break;
                case 'bin': dec = parseInt(raw, 2); break;
                case 'oct': dec = parseInt(raw, 8); break;
            }
            if (isNaN(dec)) throw new Error('Invalid input');
        } catch(e) {
            errEl.textContent = 'Invalid input for selected base.';
            errEl.style.display = 'block';
            return;
        }
        if (from !== 'dec') document.getElementById('baseDec').value = dec.toString(10);
        if (from !== 'hex') document.getElementById('baseHex').value = dec.toString(16).toUpperCase();
        if (from !== 'bin') document.getElementById('baseBin').value = dec.toString(2);
        if (from !== 'oct') document.getElementById('baseOct').value = dec.toString(8);
    }

